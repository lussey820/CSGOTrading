#### Database ####
# Local DB
CS2_DB_PATH=assets/cs2.db

#### SteamDT Market Data ####
# SteamDT 开放平台 API key(实时价格 / K线 / 饰品搜索),必填
STEAMDT_API_KEY=YOUR_KEY_HERE

#### Offical LLM ####

# Deepseek API key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=YOUR_API_HERE
# Qwen API key from https://www.alibabacloud.com/help/en/model-studio/what-is-qwen-llm
QWEN_API_KEY=YOUR_API_HERE

#Moonshot API key from
KIMI_API_KEY=YOUR_API_HERE
# AiHubMix API key from https://aihubmix.com/
AIHUBMIX_API_KEY=YOUR_API_HERE

# Yi-Zhan API key from https://vip.yi-zhan.top/
YIZHAN_API_KEY=YOUR_API_HERE

REDDIT_CLIENT_ID=YOUR_ID_HERE
REDDIT_CLIENT_SECRET=YOUR_SECRET_HERE
REDDIT_USER_AGENT=YOUR_USER_AGENT

#### WeChat Push ####
# Provider: serverchan (Server酱) or pushplus
PUSH_PROVIDER=serverchan
# Server酱 sendkey or pushplus token
PUSH_TOKEN=YOUR_TOKEN_HERE

#### AI Account Auto Run ####
# AI 虚拟账户自动轮次间隔(秒);0 = 不自动,需手动点击「运行 AI 账户」
AI_ACCOUNT_AUTO_INTERVAL=0


